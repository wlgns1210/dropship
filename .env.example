# ─────────────────────────────────────────────────────────────
# Skiff 환경 변수
# 로컬 개발: 이 파일을 .env 로 복사하면 그대로 동작한다 (LocalStack 기준)
# ─────────────────────────────────────────────────────────────

# 실행 환경: local | production
SKIFF_ENV=local

# ── AWS ──
AWS_REGION=ap-northeast-2
# LocalStack 사용 시에만 지정. 실제 AWS 배포 시에는 비워 둘 것.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── 저장소 ──
S3_BUCKET=skiff-files-local
DYNAMODB_TABLE=skiff-local

# ── 서비스 ──
# IP 해시용 솔트 — 운영에서는 반드시 Secrets Manager 값으로 교체한다.
# 이 값이 바뀌면 진행 중인 일일 쿼터 집계가 초기화된다.
IP_HASH_SALT=change-me-in-production

# CloudFront 가 오리진 요청에 붙이는 공유 비밀.
# 값이 있으면 이 헤더가 없는 요청을 403 으로 거부한다.
# Lambda 함수 URL 은 공개 주소라 이게 없으면 누구나 CloudFront 를 건너뛰고
# 직접 호출해 X-Forwarded-For 를 위조할 수 있다. 로컬에서는 비워 둔다.
ORIGIN_SECRET=

# ── 다운로드 서명 ──
# local: S3 presigned URL / cloudfront: CloudFront signed URL
DOWNLOAD_SIGNER=local
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# ── 프론트엔드 ──
# 브라우저에서 호출할 API 주소.
# 운영에서는 CloudFront 가 프론트와 API 를 같은 도메인에 묶으므로 비워 둔다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
