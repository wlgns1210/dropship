# Skiff 컨테이너 배포 설정. .env 로 복사해 채운다.
#
#   python scripts/gen_secrets.py   # IP_HASH_SALT, URL_SIGNING_KEY 생성
#
# 이 파일은 저장소에 두지 않는다(.gitignore 에 .env 가 있다).

# IP 해시 솔트 — 바꾸면 진행 중인 일일 쿼터 집계가 초기화된다.
IP_HASH_SALT=

# 업로드·다운로드 토큰 서명 키 — **바꾸면 이미 발급된 링크가 즉시 죽는다.**
URL_SIGNING_KEY=

# 관리자 페이지(/admin) 토큰.
# 비워 두면 관리자 API 가 아예 등록되지 않는다(401 이 아니라 404).
ADMIN_TOKEN=

# 이미지를 받아올 곳. 포크했다면 자기 소유자로 바꾼다.
SKIFF_REGISTRY=ghcr.io/wlgns1210

# 이미지 태그. 운영에서는 latest 보다 태그 고정이 안전하다 (예: v1.2.3)
SKIFF_TAG=latest

# 호스트에 노출할 포트. 앞단에 TLS 종단을 두는 것이 전제다.
#
# 포트만 쓰면 0.0.0.0 에 붙어 인터넷에 그대로 열린다. Docker 는 ufw 를
# 우회하므로 방화벽으로 막았다고 믿으면 안 된다. 앞단 프록시를 둔다면
# 127.0.0.1:8090 처럼 주소를 붙여 루프백에만 묶는다.
SKIFF_PORT=8090

# 만료 정리 주기(초)
SWEEP_INTERVAL_SECONDS=300
