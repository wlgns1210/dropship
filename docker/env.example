# Skiff 컨테이너 배포 설정. .env 로 복사해 채운다.
#
#   python scripts/gen_secrets.py   # IP_HASH_SALT, URL_SIGNING_KEY 생성
#
# 이 파일은 저장소에 두지 않는다(.gitignore 에 .env 가 있다).

# IP 해시 솔트 — 바꾸면 진행 중인 일일 쿼터 집계가 초기화된다.
IP_HASH_SALT=

# 업로드·다운로드 토큰 서명 키 — **바꾸면 이미 발급된 링크가 즉시 죽는다.**
URL_SIGNING_KEY=

# 관리자 페이지(/admin) 토큰.
# 비워 두면 관리자 API 가 아예 등록되지 않는다(401 이 아니라 404).
ADMIN_TOKEN=

# 호스트에 노출할 포트. 앞단에 TLS 종단을 두는 것이 전제다.
SKIFF_PORT=8090

# 만료 정리 주기(초)
SWEEP_INTERVAL_SECONDS=300
